{
  "name": "dsh-token-perf",
  "version": "0.1.0",
  "description": "DeepSeek Harness 单日 token / 会话 / 子代理分析插件：一天的 token 用量与按模型拆分、会话与子代理开启量、user/assistant 消息分布、tool call/result 数量、context compact 调用情况与 token 消耗速率，Web GUI 设置面板内查看，中英双语。Daily token and workflow analytics for DeepSeek Harness: one local day's token usage by model, sessions and subagents opened, user/assistant message distribution, tool call/result counts, context compactions, and token consumption rate, rendered inside the Web GUI settings panel in Chinese and English.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/NolanHo/dsh-token-perf"
  },
  "homepage": "https://github.com/NolanHo/dsh-token-perf#readme",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/zstd-dictionary.bin",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown && cp src/store/zstd-dictionary.bin lib/zstd-dictionary.bin",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "token",
    "usage",
    "analytics",
    "perf",
    "subagent",
    "session",
    "dashboard"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
